# 공공데이터포털(data.go.kr) → "행정안전부_대한민국 공공서비스(혜택) 정보" 활용신청 후 받은 일반 인증키(Decoding)
DATA_GO_KR_KEY=

# 서버
PORT=8080
DB_PATH=./data/hyetaek.db
# 관리자 API·관리자 화면 접근 토큰 (긴 임의 문자열로 바꾸세요)
ADMIN_TOKEN=change-me-to-a-long-random-string

# 자동 수집·알림 실행 시각 (0~23시, 서버 시간 기준)
SYNC_HOUR=4

# 공공서비스 API 주소 (기본값 그대로 두면 됨)
GOV24_BASE=https://api.odcloud.kr/api

# 마감 알림 이메일 발송(선택). 비워두면 앱 안 알림함에만 쌓임
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
